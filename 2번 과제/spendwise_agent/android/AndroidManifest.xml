<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.jamin3874.spendwise" android:versionCode="1" android:versionName="1.0.0">
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="35" />
    <application android:label="SpendWise" android:icon="@drawable/spendwise"
        android:allowBackup="false" android:usesCleartextTraffic="false">
        <activity android:name=".MainActivity" android:exported="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
